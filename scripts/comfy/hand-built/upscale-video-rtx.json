{
  "1": {
    "class_type": "VHS_LoadVideo",
    "inputs": {
      "video": "input.mp4",
      "force_rate": 0,
      "custom_width": 0,
      "custom_height": 0,
      "frame_load_cap": 0,
      "skip_first_frames": 0,
      "select_every_nth": 1,
      "format": "None",
      "meta_batch": [
        "2",
        0
      ]
    },
    "_meta": {
      "title": "Clip, decoded framesPerBatch frames per pass"
    }
  },
  "2": {
    "class_type": "VHS_BatchManager",
    "inputs": {
      "frames_per_batch": 16
    },
    "_meta": {
      "title": "Meta batch: re-queue every framesPerBatch frames (memory stays flat)"
    }
  },
  "3": {
    "class_type": "VHS_VideoInfo",
    "inputs": {
      "video_info": [
        "1",
        3
      ]
    },
    "_meta": {
      "title": "Source frame rate and size"
    }
  },
  "4": {
    "class_type": "PrimitiveInt",
    "inputs": {
      "value": 1080
    },
    "_meta": {
      "title": "Shorter edge asked for (shortSide)"
    }
  },
  "5": {
    "class_type": "ComfyMathExpression",
    "inputs": {
      "expression": "min(4, max(1, a / min(b, c)))",
      "values.a": [
        "4",
        0
      ],
      "values.b": [
        "3",
        8
      ],
      "values.c": [
        "3",
        9
      ]
    },
    "_meta": {
      "title": "RTX scale: shortSide / the clip's shorter edge, 1-4x"
    }
  },
  "6": {
    "class_type": "RTXVideoSuperResolution",
    "inputs": {
      "images": [
        "1",
        0
      ],
      "resize_type": "scale by multiplier",
      "resize_type.scale": [
        "5",
        0
      ],
      "quality": "ULTRA",
      "strength": 1.0,
      "image_encoding": "8-bit RGB"
    },
    "_meta": {
      "title": "RTX Video Super Resolution (quality: rtxQuality)"
    }
  },
  "7": {
    "class_type": "ResizeImageMaskNode",
    "inputs": {
      "input": [
        "6",
        0
      ],
      "resize_type": "scale shorter dimension",
      "resize_type.shorter_size": [
        "4",
        0
      ],
      "scale_method": "lanczos"
    },
    "_meta": {
      "title": "Exactly shortSide px on the shorter edge (RTX rounds sizes to 8)"
    }
  },
  "8": {
    "class_type": "VHS_VideoCombine",
    "inputs": {
      "images": [
        "7",
        0
      ],
      "audio": [
        "1",
        2
      ],
      "frame_rate": [
        "3",
        5
      ],
      "loop_count": 0,
      "filename_prefix": "fuobe/upscale-video-rtx",
      "format": "video/h264-mp4",
      "pix_fmt": "yuv420p",
      "crf": 17,
      "save_metadata": true,
      "trim_to_audio": false,
      "pingpong": false,
      "save_output": true,
      "meta_batch": [
        "2",
        0
      ]
    },
    "_meta": {
      "title": "Encode as the passes come (the last pass writes the file, with the source's sound)"
    }
  }
}
