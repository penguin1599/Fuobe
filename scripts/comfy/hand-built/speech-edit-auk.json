{
  "1": {
    "class_type": "LoadAudio",
    "inputs": {
      "audio": "input.wav"
    },
    "_meta": {
      "title": "Recording to edit (audio; a video's soundtrack works too)"
    }
  },
  "2": {
    "class_type": "LoadAudio",
    "inputs": {
      "audio": "fade.wav"
    },
    "_meta": {
      "title": "Fade-in curve the provider writes: a linear ramp, then a flat tail AudioMerge trims off (fadeCurve)"
    }
  },
  "3": {
    "class_type": "SplitAudioChannels",
    "inputs": {
      "audio": [
        "2",
        0
      ]
    },
    "_meta": {
      "title": "Fade-in (left)"
    }
  },
  "4": {
    "class_type": "AuKModelLoader",
    "inputs": {
      "checkpoint_path": "ckpts/AuK-Flash/auk_flash.safetensors",
      "config_path": "",
      "qwen_path": "ckpts/Qwen2.5-Omni-3B",
      "device": "cuda:0",
      "dtype": "bf16",
      "cpu_offload": false
    },
    "_meta": {
      "title": "AuK Model Loader (AuK-Flash; paths under the AuK checkout)"
    }
  },
  "5": {
    "class_type": "EmptyAudio",
    "inputs": {
      "duration": 0.05,
      "sample_rate": 24000,
      "channels": 1
    },
    "_meta": {
      "title": "Silence at AuK's 24 kHz"
    }
  },
  "6": {
    "class_type": "AudioMerge",
    "inputs": {
      "audio1": [
        "1",
        0
      ],
      "audio2": [
        "5",
        0
      ],
      "merge_method": "add"
    },
    "_meta": {
      "title": "The recording at max(its rate, 24 kHz), so no seam is resampled"
    }
  },
  "10": {
    "class_type": "TrimAudioDuration",
    "inputs": {
      "audio": [
        "6",
        0
      ],
      "start_index": 1.0,
      "duration": 4.0
    },
    "_meta": {
      "title": "Window 1: the change with at least 1 s of untouched speech on each side"
    }
  },
  "11": {
    "class_type": "AuKGenerateEdit",
    "inputs": {
      "engine": [
        "4",
        0
      ],
      "instruction": "Replace 'Tuesday' with 'Thursday'.",
      "generation_seconds": 4.2,
      "use_prompt_enhancer": false,
      "seed": 42,
      "nfe_steps": 4,
      "cfg_strength": 0.0,
      "sway_sampling_coef": -1.0,
      "input_audio": [
        "10",
        0
      ]
    },
    "_meta": {
      "title": "AuK Generate / Edit (window 1)"
    }
  },
  "12": {
    "class_type": "AudioMerge",
    "inputs": {
      "audio1": [
        "10",
        0
      ],
      "audio2": [
        "10",
        0
      ],
      "merge_method": "subtract"
    },
    "_meta": {
      "title": "Silence at the recording's rate"
    }
  },
  "13": {
    "class_type": "AudioMerge",
    "inputs": {
      "audio1": [
        "11",
        0
      ],
      "audio2": [
        "12",
        0
      ],
      "merge_method": "add"
    },
    "_meta": {
      "title": "The edit at the recording's rate"
