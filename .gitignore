# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local data (db, uploads, outputs)
/data/

# local deploy notes: never part of this repo
/deploy/
/docs/deploy.md

# evaluation harness (scripts/eval): your own inputs, run results and the metrics venv stay local
/scripts/eval/local/
/scripts/eval/results/
/scripts/eval/metrics/.venv/
__pycache__/

# The worker's built parts (scripts/build-worker.mjs)
/bin/lib/worker/dist/

# The training kit's job configs (scripts/train/kit.mjs job)
/.train/
