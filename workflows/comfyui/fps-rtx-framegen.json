{
  "1": {
    "class_type": "LoadVideo",
    "inputs": {
      "file": "input.mp4"
    },
    "_meta": {
      "title": "Clip (video)"
    }
  },
  "2": {
    "class_type": "GetVideoComponents",
    "inputs": {
      "video": [
        "1",
        0
      ]
    },
    "_meta": {
      "title": "Frames, sound, fps"
    }
  },
  "3": {
    "class_type": "ImageFromBatch",
    "inputs": {
      "image": [
        "2",
        0
      ],
      "batch_index": -1,
      "length": 1
    },
    "_meta": {
      "title": "Last frame"
    }
  },
  "4": {
    "class_type": "ImageBatch",
    "inputs": {
      "image1": [
        "2",
        0
      ],
      "image2": [
        "3",
        0
      ]
    },
    "_meta": {
      "title": "Hold the last frame once more (N frames -> N x m + 1)"
    }
  },
  "6": {
    "class_type": "PrimitiveInt",
    "inputs": {
      "value": 2
    },
    "_meta": {
      "title": "m: frame-rate multiplier (2-16)"
    }
  },
  "7": {
    "class_type": "RTXVideoFrameGeneration",
    "inputs": {
      "images": [
        "4",
        0
      ],
      "generation_type": "frame rate multiplier",
      "generation_type.multiplier": [
        "6",
        0
      ],
      "mode": "MEDIUM",
      "automatic_shot_change_detection": true,
      "shot_change": false,
      "image_encoding": "8-bit RGB"
    },
    "_meta": {
      "title": "RTX Video Frame Generation: (N - 1) x m + 1 frames, cuts detected"
    }
  },
  "8": {
    "class_type": "PrimitiveInt",
    "inputs": {
      "value": 1
    },
    "_meta": {
      "title": "n: keep every n-th frame"
    }
  },
  "9": {
    "class_type": "VHS_SelectEveryNthImage",
    "inputs": {
      "images": [
        "7",
        0
      ],
      "select_every_nth": [
        "8",
        0
      ],
      "skip_first_images": 0
    },
    "_meta": {
      "title": "Every n-th frame"
    }
  },
  "10": {
    "class_type": "PrimitiveFloat",
    "inputs": {
      "value": 1
    },
    "_meta": {
      "title": "Slow-motion factor"
    }
  },
  "11": {
    "class_type": "ComfyMathExpression",
    "inputs": {
      "expression": "a * b / (c * d)",
      "values.a": [
        "2",
        2
      ],
      "values.b": [
        "6",
        0
      ],
      "values.c": [
        "8",
        0
      ],
      "values.d": [
        "10",
        0
      ]
    },
    "_meta": {
      "title": "Output fps = source fps x m / (n x slowdown)"
    }
  },
  "12": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": [
        "9",
        0
      ],
      "fps": [
        "11",
        0
      ],
      "audio": [
        "2",
        1
      ],
      "bit_depth": "auto",
      "color_space": "sRGB",
      "codec": "none"
    },
    "_meta": {
      "title": "Video at the new rate, with the sound"
    }
  },
  "13": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": [
        "12",
        0
      ],
      "filename_prefix": "fuobe/fps-rtx-framegen",
      "format": "auto",
      "format.codec": "auto",
      "codec": "auto"
    },
    "_meta": {
      "title": "Save MP4"
    }
  }
}
